{
  "name": "finger-gestures",
  "version": "0.1.1",
  "description": "Multi-finger taps and swipes for the web, built on Pointer Events. Two-finger tap to undo, three-finger swipe up, four-finger tap: any finger count, any direction. Zero dependencies.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaimzh/finger-gestures.git"
  },
  "homepage": "https://finger-gestures.vercel.app/",
  "keywords": [
    "gesture",
    "touch",
    "tap",
    "swipe",
    "multi-touch",
    "multi-finger",
    "two-finger",
    "three-finger",
    "four-finger",
    "undo",
    "redo",
    "pointer-events"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite demo --host",
    "build:demo": "vite build --config vite.config.ts",
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
